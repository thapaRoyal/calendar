---
import '@thaparoyal/calendar-core/themes/themes.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Svelte Playground - @thaparoyal/calendar</title>
    <link rel="stylesheet" href="/src/styles/custom.css" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #0a0a0f;
        color: #fff;
        min-height: 100vh;
      }
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        background: rgba(10, 10, 15, 0.8);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid #222;
      }
      nav a {
        color: #fff;
        text-decoration: none;
      }
      .nav-links {
        display: flex;
        gap: 2rem;
      }
      .nav-links a {
        color: #888;
        transition: color 0.2s;
      }
      .nav-links a:hover,
      .nav-links a.active {
        color: #fff;
      }
      .playground-tabs {
        display: flex;
        gap: 1rem;
        padding: 1rem 2rem;
        background: #111;
        border-bottom: 1px solid #222;
      }
      .playground-tabs a {
        padding: 0.5rem 1rem;
        border-radius: 0.25rem;
        text-decoration: none;
        color: #888;
        transition: all 0.2s;
      }
      .playground-tabs a:hover {
        background: #222;
        color: #fff;
      }
      .playground-tabs a.active {
        background: #ff3e00;
        color: #fff;
      }
      .playground-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
      }
      .coming-soon {
        text-align: center;
        padding: 4rem 2rem;
      }
      .coming-soon h2 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #ff3e00;
      }
      .coming-soon p {
        color: #888;
        max-width: 500px;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" style="font-weight: 700; font-size: 1.1rem;">@thaparoyal/calendar</a>
      <div class="nav-links">
        <a href="/docs/getting-started/introduction/">Docs</a>
        <a href="/playground/react/" class="active">Playground</a>
        <a href="https://github.com/thaparoyal/calendar" target="_blank">GitHub</a>
      </div>
    </nav>

    <div class="playground-tabs">
      <a href="/playground/react/">React</a>
      <a href="/playground/vue/">Vue</a>
      <a href="/playground/svelte/" class="active">Svelte</a>
    </div>

    <div class="playground-container">
      <div class="coming-soon">
        <h2>Svelte Playground</h2>
        <p>Svelte components with range selection and multi-calendar support are coming soon. Check back later for updates!</p>
      </div>
    </div>
  </body>
</html>
