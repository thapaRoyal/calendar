---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - @thaparoyal/calendar</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #09090b;
        color: #fafafa;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* Nav */
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2rem;
        height: 56px;
        background: rgba(9, 9, 11, 0.85);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid #1e1e2e;
      }
      nav .brand {
        color: #fafafa;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: -0.01em;
      }
      .nav-links {
        display: flex;
        gap: 1.5rem;
      }
      .nav-links a {
        color: #71717a;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: color 0.15s;
      }
      .nav-links a:hover,
      .nav-links a.active {
        color: #fafafa;
      }

      /* Calendar width fix */
      .trc-calendar {
        width: 100%;
      }

      @media (max-width: 768px) {
        nav {
          padding: 0 1rem;
        }
        .playground-content {
          padding-left: 1rem;
          padding-right: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="brand">@thaparoyal/calendar</a>
      <div class="nav-links">
        <a href="/getting-started/introduction/">Docs</a>
        <a href="/playground/react/" class="active">Playground</a>
        <a href="https://github.com/thaparoyal/calendar" target="_blank">GitHub</a>
      </div>
    </nav>

    <div class="playground-content">
      <slot />
    </div>
  </body>
</html>
