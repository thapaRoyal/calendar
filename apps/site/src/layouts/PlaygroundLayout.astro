---
interface Props {
  title: string;
  activeTab: 'react' | 'vue' | 'svelte' | 'vanilla';
}
const { title, activeTab } = Astro.props;

const tabColors: Record<string, string> = {
  react: '#667eea',
  vue: '#42b883',
  svelte: '#ff3e00',
  vanilla: '#f7df1e',
};
const activeColor = tabColors[activeTab];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - @thaparoyal/calendar</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #09090b;
        color: #fafafa;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* Nav */
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2rem;
        height: 56px;
        background: rgba(9, 9, 11, 0.85);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid #1e1e2e;
      }
      nav .brand {
        color: #fafafa;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: -0.01em;
      }
      .nav-links {
        display: flex;
        gap: 1.5rem;
      }
      .nav-links a {
        color: #71717a;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: color 0.15s;
      }
      .nav-links a:hover,
      .nav-links a.active {
        color: #fafafa;
      }

      /* Tabs */
      .playground-tabs {
        display: flex;
        gap: 0.375rem;
        padding: 0.75rem 2rem;
        background: #0f0f13;
        border-bottom: 1px solid #1e1e2e;
      }
      .playground-tabs a {
        padding: 0.5rem 1.25rem;
        border-radius: 6px;
        text-decoration: none;
        color: #71717a;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.15s;
      }
      .playground-tabs a:hover {
        background: #18181b;
        color: #fafafa;
      }
      .playground-tabs a.active {
        background: var(--active-tab-color);
        color: #fff;
      }

      /* Container */
      .playground-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
      }

      /* Grid */
      .playground-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.25rem;
        margin-top: 1.5rem;
      }

      /* Cards */
      .playground-card {
        background: #111118;
        border: 1px solid #1e1e2e;
        border-radius: 12px;
        padding: 1.5rem;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .playground-card:hover {
        border-color: #2a2a3a;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
      }
      .playground-card h3 {
        margin-top: 0;
        margin-bottom: 0.75rem;
        font-size: 1rem;
        font-weight: 600;
        color: #e4e4e7;
      }

      /* Calendar width fix */
      .calendar-demo .trc-calendar,
      .playground-card .trc-calendar {
        width: 100%;
      }

      /* Theme selector */
      .theme-selector {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
      }
      .theme-selector button {
        padding: 0.35rem 0.75rem;
        border: 1px solid #27272a;
        border-radius: 6px;
        background: #18181b;
        color: #71717a;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 500;
        transition: all 0.15s;
      }
      .theme-selector button:hover {
        border-color: #3f3f46;
        color: #a1a1aa;
      }
      .theme-selector button.active {
        background: var(--active-tab-color);
        color: #fff;
        border-color: var(--active-tab-color);
      }

      @media (max-width: 768px) {
        .playground-grid {
          grid-template-columns: 1fr;
        }
        .playground-tabs {
          overflow-x: auto;
          gap: 0.25rem;
          padding: 0.5rem 1rem;
        }
        .playground-container {
          padding: 1.25rem;
        }
        nav {
          padding: 0 1rem;
        }
      }
    </style>
  </head>
  <body style={`--active-tab-color: ${activeColor}`}>
    <nav>
      <a href="/" class="brand">@thaparoyal/calendar</a>
      <div class="nav-links">
        <a href="/getting-started/introduction/">Docs</a>
        <a href="/playground/react/" class="active">Playground</a>
        <a href="https://github.com/thaparoyal/calendar" target="_blank">GitHub</a>
      </div>
    </nav>

    <div class="playground-tabs">
      <a href="/playground/react/" class={activeTab === 'react' ? 'active' : ''}>React</a>
      <a href="/playground/vue/" class={activeTab === 'vue' ? 'active' : ''}>Vue</a>
      <a href="/playground/svelte/" class={activeTab === 'svelte' ? 'active' : ''}>Svelte</a>
      <a href="/playground/vanilla/" class={activeTab === 'vanilla' ? 'active' : ''}>Vanilla JS</a>
    </div>

    <slot />
  </body>
</html>
