---
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
---

<PlaygroundLayout title="Vanilla JS Playground" activeTab="vanilla">
  <div class="playground-container">
    <h2 class="vp-heading">Vanilla JS Playground</h2>
    <p class="vp-subtitle">
      Render calendars with plain JavaScript using <code class="vp-code">TRCalendar.render()</code>
    </p>

    <div class="playground-grid">
      <div class="playground-card">
        <h3>BS Calendar (Default)</h3>
        <div id="vanilla-bs-calendar" class="calendar-demo">
          <div class="vanilla-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#f7df1e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <p>BS Calendar</p>
            <span class="vp-config">calendarType: BS</span>
          </div>
        </div>
      </div>

      <div class="playground-card">
        <h3>AD Calendar (Gregorian)</h3>
        <div id="vanilla-ad-calendar" class="calendar-demo">
          <div class="vanilla-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#f7df1e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
              <circle cx="12" cy="16" r="1"></circle>
            </svg>
            <p>AD Calendar</p>
            <span class="vp-config">calendarType: AD</span>
          </div>
        </div>
      </div>

      <div class="playground-card">
        <h3>Nepali Locale</h3>
        <div id="vanilla-ne-calendar" class="calendar-demo">
          <div class="vanilla-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#f7df1e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <p>Nepali Numerals</p>
            <span class="vp-config">locale: ne</span>
          </div>
        </div>
      </div>

      <div class="playground-card">
        <h3>Range Selection</h3>
        <div id="vanilla-range-calendar" class="calendar-demo">
          <div class="vanilla-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#f7df1e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
              <polyline points="9 15 12 18 15 15"></polyline>
            </svg>
            <p>Range Selection</p>
            <span class="vp-config">mode: range</span>
          </div>
        </div>
      </div>
    </div>

    <div class="vp-usage-box">
      <h3 class="vp-usage-title">Usage Example</h3>
      <pre class="vp-usage-code"><code>{`// Import via CDN
<script src="https://cdn.jsdelivr.net/npm/@thaparoyal/calendar-vanilla/dist/cdn/index.global.js"><\/script>

// Render a BS calendar
TRCalendar.render('#my-calendar', {
  config: { calendarType: 'BS', locale: 'en' },
  theme: 'ocean',
  onValueChange: (date) => console.log('Selected:', date)
});`}</code></pre>
    </div>
  </div>

  <style>
    .vp-heading {
      margin-bottom: 0.5rem;
      font-size: 1.5rem;
    }
    .vp-subtitle {
      color: #888;
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }
    .vp-code {
      background: #1a1a2e;
      padding: 0.15rem 0.4rem;
      border-radius: 0.25rem;
      font-size: 0.85rem;
      color: #f7df1e;
    }
    .vp-config {
      color: #666;
      font-size: 0.8rem;
      font-family: 'SF Mono', 'Fira Code', monospace;
      background: #1a1a2e;
      padding: 0.2rem 0.6rem;
      border-radius: 0.25rem;
    }
    .vanilla-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
      border: 2px dashed #2a2a3a;
      border-radius: 0.5rem;
      background: #0d0d14;
      text-align: center;
      gap: 0.75rem;
    }
    .vanilla-placeholder p {
      color: #ccc;
      font-size: 1rem;
      font-weight: 600;
    }
    .vp-usage-box {
      margin-top: 2.5rem;
      padding: 1.5rem;
      background: #111118;
      border: 1px solid #1e1e2e;
      border-radius: 0.75rem;
    }
    .vp-usage-title {
      margin-bottom: 1rem;
      color: #f7df1e;
    }
    .vp-usage-code {
      background: #0a0a0f;
      padding: 1.25rem;
      border-radius: 0.5rem;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.6;
      color: #ccc;
    }
  </style>
</PlaygroundLayout>
