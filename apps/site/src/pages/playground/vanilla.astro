---
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
---

<PlaygroundLayout title="Vanilla JS Playground" activeTab="vanilla">
  <div class="playground-container">
    <h2 class="vp-heading">Vanilla JS Playground</h2>
    <p class="vp-subtitle">
      Render calendars with plain JavaScript using <code class="vp-code">TRCalendar.render()</code>
    </p>

    <div class="playground-grid">
      <div class="playground-card">
        <h3>BS Calendar (Default)</h3>
        <p class="vp-card-desc">Bikram Sambat calendar with single date selection</p>
        <div id="vanilla-bs" class="vp-cal-container" data-theme="dark"></div>
        <div id="vanilla-bs-value" class="vp-value">Selected: —</div>
      </div>

      <div class="playground-card">
        <h3>AD Calendar (Ocean)</h3>
        <p class="vp-card-desc">Gregorian calendar with ocean theme</p>
        <div id="vanilla-ad" class="vp-cal-container" data-theme="ocean"></div>
        <div id="vanilla-ad-value" class="vp-value">Selected: —</div>
      </div>

      <div class="playground-card">
        <h3>Nepali Numerals</h3>
        <p class="vp-card-desc">BS calendar with Nepali (Devanagari) numerals</p>
        <div id="vanilla-ne" class="vp-cal-container" data-theme="sunset"></div>
        <div id="vanilla-ne-value" class="vp-value">Selected: —</div>
      </div>

      <div class="playground-card">
        <h3>Range Selection</h3>
        <p class="vp-card-desc">Select a start and end date range</p>
        <div id="vanilla-range" class="vp-cal-container" data-theme="royal"></div>
        <div id="vanilla-range-value" class="vp-value">Range: — → —</div>
      </div>
    </div>

    <div class="vp-usage-box">
      <h3 class="vp-usage-title">Usage Example</h3>
      <pre class="vp-usage-code"><code>&lt;!-- Import via CDN --&gt;
&lt;link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@thaparoyal/calendar-core/themes/themes.css"&gt;
&lt;script src="https://cdn.jsdelivr.net/npm/@thaparoyal/calendar-vanilla/dist/cdn/index.global.js"&gt;&lt;/script&gt;

&lt;div id="my-calendar" data-theme="ocean"&gt;&lt;/div&gt;

&lt;script&gt;
  TRCalendar.render('#my-calendar', &#123;
    config: &#123; calendarType: 'BS', locale: 'en' &#125;,
    theme: 'ocean',
    onValueChange: (date) =&gt; console.log('Selected:', date)
  &#125;);
&lt;/script&gt;</code></pre>
    </div>
  </div>

  <script>
    import { render } from '@thaparoyal/calendar-vanilla';

    function fmtDate(d: any): string {
      if (!d) return '—';
      return `${d.year}-${String(d.month).padStart(2, '0')}-${String(d.day).padStart(2, '0')} (${d.calendarType})`;
    }

    // BS Calendar
    render('#vanilla-bs', {
      config: { calendarType: 'BS', locale: 'en' },
      selectionMode: 'single',
      onValueChange: (val) => {
        const el = document.getElementById('vanilla-bs-value');
        if (el) el.textContent = `Selected: ${fmtDate(val)}`;
      },
    });

    // AD Calendar
    render('#vanilla-ad', {
      config: { calendarType: 'AD', locale: 'en' },
      selectionMode: 'single',
      onValueChange: (val) => {
        const el = document.getElementById('vanilla-ad-value');
        if (el) el.textContent = `Selected: ${fmtDate(val)}`;
      },
    });

    // Nepali Numerals
    render('#vanilla-ne', {
      config: { calendarType: 'BS', locale: 'ne' },
      selectionMode: 'single',
      onValueChange: (val) => {
        const el = document.getElementById('vanilla-ne-value');
        if (el) el.textContent = `Selected: ${fmtDate(val)}`;
      },
    });

    // Range Selection
    render('#vanilla-range', {
      config: { calendarType: 'BS', locale: 'en' },
      selectionMode: 'range',
      onValueChange: (val: any) => {
        const el = document.getElementById('vanilla-range-value');
        if (el && val) {
          el.textContent = `Range: ${fmtDate(val.start)} → ${fmtDate(val.end)}`;
        }
      },
    });
  </script>

  <style>
    .vp-heading {
      margin-bottom: 0.25rem;
      font-size: 1.75rem;
      font-weight: 700;
    }
    .vp-subtitle {
      color: #888;
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }
    .vp-code {
      background: #1a1a2e;
      padding: 0.15rem 0.4rem;
      border-radius: 0.25rem;
      font-size: 0.85rem;
      color: #f7df1e;
    }
    .vp-card-desc {
      color: #666;
      font-size: 0.8rem;
      margin: -0.5rem 0 1rem;
    }
    .vp-cal-container {
      min-height: 280px;
    }
    .vp-value {
      font-size: 0.8rem;
      color: #888;
      background: #0d0d14;
      border: 1px solid #1a1a2e;
      border-radius: 6px;
      padding: 0.5rem 0.75rem;
      font-family: monospace;
      margin-top: 0.75rem;
    }
    .vp-usage-box {
      margin-top: 2.5rem;
      padding: 1.5rem;
      background: #111118;
      border: 1px solid #1e1e2e;
      border-radius: 0.75rem;
    }
    .vp-usage-title {
      margin-bottom: 1rem;
      color: #f7df1e;
    }
    .vp-usage-code {
      background: #0a0a0f;
      padding: 1.25rem;
      border-radius: 0.5rem;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.6;
      color: #ccc;
    }
  </style>
</PlaygroundLayout>
