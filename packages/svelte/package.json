{
  "name": "@thaparoyal/calendar-svelte",
  "version": "0.2.0",
  "description": "Svelte components for AD and BS (Bikram Sambat) calendars",
  "author": "Royal Thapa",
  "license": "MIT",
  "homepage": "https://thaparoyal.github.io/calendar/",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@thaparoyal/calendar-core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "svelte",
    "calendar",
    "nepali",
    "bikram-sambat",
    "date-picker",
    "nepali-date"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thaparoyal/calendar.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  }
}
