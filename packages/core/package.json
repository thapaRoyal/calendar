{
  "name": "@thaparoyal/calendar-core",
  "version": "2.0.0",
  "description": "Core date conversion and calendar utilities for AD and BS (Bikram Sambat) calendars",
  "author": "Royal Thapa",
  "license": "MIT",
  "homepage": "https://thaparoyal.github.io/calendar/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./converters": {
      "import": {
        "types": "./dist/converters/index.d.ts",
        "default": "./dist/converters/index.js"
      },
      "require": {
        "types": "./dist/converters/index.d.cts",
        "default": "./dist/converters/index.cjs"
      }
    },
    "./themes/themes.css": "./themes/themes.css",
    "./themes/*": "./themes/*"
  },
  "files": [
    "dist",
    "themes",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "calendar",
    "nepali",
    "bikram-sambat",
    "bs",
    "ad",
    "gregorian",
    "date-converter",
    "nepali-date"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thaparoyal/calendar.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
