{
  "name": "@thaparoyal/calendar-vanilla",
  "version": "2.0.0",
  "description": "Vanilla JS calendar components for AD and BS (Bikram Sambat) calendars",
  "author": "Royal Thapa",
  "license": "MIT",
  "homepage": "https://thaparoyal.github.io/calendar/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cdn": "./dist/cdn/index.global.js"
  },
  "unpkg": "./dist/cdn/index.global.js",
  "jsdelivr": "./dist/cdn/index.global.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@thaparoyal/calendar-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaparoyal/calendar.git",
    "directory": "packages/vanilla"
  },
  "publishConfig": {
    "access": "public"
  }
}
