{
  "name": "@thaparoyal/calendar-vue",
  "version": "0.2.0",
  "description": "Vue components for AD and BS (Bikram Sambat) calendars",
  "author": "Royal Thapa",
  "license": "MIT",
  "homepage": "https://thaparoyal.github.io/calendar/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@thaparoyal/calendar-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "vue",
    "calendar",
    "nepali",
    "bikram-sambat",
    "date-picker",
    "nepali-date"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thaparoyal/calendar.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
